    "axios": "^0.26.1",
    "core-js": "^3.8.3",
    "dayjs": "^1.11.3",
    "echarts": "^5.3.3",
    "element-plus": "^2.5.6",
    "eslint-plugin-vue": "^9.14.1",
    "js-cookie": "^3.0.1",
    "lodash": "^4.17.21",
    "normalize.css": "^8.0.1",
    "nprogress": "^0.2.0",
    "path-browserify": "^1.0.1",
    "path-to-regexp": "^6.2.0",
    "pinia": "^2.0.13",
    "screenfull": "^6.0.2",
    "svg-sprite-loader": "^6.0.11",
    "svgo": "^2.8.0",
